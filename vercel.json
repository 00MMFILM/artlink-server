{
  "version": 2,
  "functions": {
    "api/analyze-video.js": {
      "maxDuration": 120
    },
    "api/ai-analyze.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "art-link.kr" }],
      "destination": "/launch",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/api/app"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
