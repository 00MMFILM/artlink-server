{
  "version": 2,
  "functions": {
    "api/analyze-video.js": {
      "maxDuration": 300
    },
    "api/ai-analyze.js": {
      "maxDuration": 120
    },
    "api/studio-transfer.js": {
      "maxDuration": 60
    },
    "api/speech-check.js": {
      "maxDuration": 60
    },
    "api/speech-compare.js": {
      "maxDuration": 60,
      "includeFiles": "public/speech-coach/v1/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "art-link.kr"
        }
      ],
      "destination": "/launch",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/api/app"
    },
    {
      "source": "/practice",
      "destination": "/api/practice"
    },
    {
      "source": "/casting/:id",
      "destination": "/api/casting?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/studio-transfer",
      "schedule": "15 * * * *"
    }
  ]
}
