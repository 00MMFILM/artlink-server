{
  "version": 2,
  "functions": {
    "api/analyze-video.js": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "art-link.kr" }],
      "destination": "/launch",
      "permanent": false
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ]
}
